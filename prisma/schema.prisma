generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
}

model Product {
  id        String  @id
  name      String
  nameZh    String
  flavorEn  String
  flavorZh  String
  blurb     String
  blurbZh   String
  notes     String  // Stored as JSON string
  notesZh   String  // Stored as JSON string
  options   String  // Stored as JSON string
  tone      String
  cap       String
  available Boolean @default(true)
  tagline       String @default("")
  taglineZh     String @default("")
  ingredients   String @default("")
  ingredientsZh String @default("")
  allergens     String @default("")
  sortOrder     Int    @default(0)
  stock         Int?   // jars in stock; empty = not tracked
}

model Bundle {
  id       String  @id
  title    String
  titleZh  String
  qty      Int
  price    Float
  featured Boolean @default(false)
  note     String
  noteZh   String
}

model DeliveryConfig {
  id            Int    @id @default(1)
  freeThreshold Float
  baseFee       Float
  note          String
}

model DeliverySlot {
  id         Int    @id @default(autoincrement())
  text       String
  orderIndex Int    @default(0)
}

model DeliveryZone {
  id     String @id
  name   String
  nameZh String
  fee    Float
}

model Order {
  id              String   @id @default(cuid())
  num             String   @unique
  customerDetails String   // JSON string
  slot            String
  zoneId          String
  subtotal        Float
  deliveryFee     Float
  total           Float
  status          String   @default("pending") // pending, paid
  method          String   // card, paynow
  items           String   // JSON string
  discount        Float    @default(0)
  discountDetail  String   @default("") // JSON: which member discounts were applied
  hitpayId        String?
  memberId        String?
  member          Member?  @relation(fields: [memberId], references: [id])
  region          String   @default("")      // central | east | north | northeast | west
  fulfil          String   @default("new")   // new | packed | delivered
  pointsUsed      Int      @default(0)       // points redeemed on this order
  pointsEarned    Int      @default(0)       // points this order earns once paid
  stockApplied    Boolean  @default(false)
  notified        Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([status, createdAt])
}

model Member {
  id           String   @id @default(cuid())
  num          Int      @unique @default(autoincrement())
  email        String   @unique
  passwordHash String
  name         String
  card         String   @default("{}") // JSON: avatar, pet, theme
  petState     String   @default("{}") // JSON: treats fed
  orders       Order[]
  claims       MissionClaim[]
  purchases    PetPurchase[]
  createdAt    DateTime @default(now())
}

// A mission attempt. Screenshots are never stored — only a hash (to stop the
// same image being reused) and the AI's short, non-personal verdict.
model MissionClaim {
  id          String   @id @default(cuid())
  memberId    String
  member      Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  mission     String
  status      String   // approved | denied
  reason      String   @default("")
  imageHash   String
  usedOrderId String?
  createdAt   DateTime @default(now())

  @@index([memberId])
  @@index([imageHash])
}

// Things bought with points in the pet shop (accessories and treats).
model PetPurchase {
  id        String   @id @default(cuid())
  memberId  String
  member    Member   @relation(fields: [memberId], references: [id], onDelete: Cascade)
  item      String
  cost      Int
  createdAt DateTime @default(now())

  @@index([memberId])
}

// Small key/value settings (e.g. the admin password hash, set from /admin/settings).
model Setting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}
